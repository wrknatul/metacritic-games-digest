# OpenAI-compatible LLM gateway (AnyModel; OpenRouter works too: https://openrouter.ai/api/v1)
LLM_BASE_URL=https://anymodel.org/v1
LLM_API_KEY=
# Text model for summaries and conclusions; must also accept audio for the audio strategy
LLM_MODEL=ag/gemini-3-flash
# SQLite file; on Fly it lives on the mounted volume
DATABASE_URL=sqlite:///data/games.db
# Scheduler: run every N minutes (60 = hourly, per the task)
RUN_INTERVAL_MINUTES=60
GAMES_PER_RUN=20
DETAIL_WORKERS=4
LETSPLAY_ENABLED=true
# Hard cap on LLM calls per day (cost guard)
LLM_DAILY_CALL_LIMIT=400
# Minutes of let's play audio sent to speech recognition
LETSPLAY_AUDIO_MINUTES=8
# Optional: if set, the force-run button requires this token
ADMIN_TOKEN=
